rules_version = '2';

// NOTA ARQUITECTÓNICA (MECAFUT Q4 2026):
// Firebase Firestore fue deprecado y retirado del código fuente activo.
// La persistencia oficial y control de acceso operan en Supabase PostgreSQL
// mediante políticas RLS cerradas y funciones transaccionales SECURITY DEFINER
// (ver supabase/migrations/). Este archivo bloquea cualquier acceso accidental.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
